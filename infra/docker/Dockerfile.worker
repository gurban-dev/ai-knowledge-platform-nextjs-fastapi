# syntax=docker/dockerfile:1.7
FROM python:3.12-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy
WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /usr/local/bin/uv

FROM base AS deps
COPY pyproject.toml ./
COPY uv.lock* ./
COPY packages ./packages
COPY apps/worker ./apps/worker
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
RUN mkdir -p apps/api/src/akp_api && touch apps/api/src/akp_api/__init__.py
RUN if [ -f uv.lock ]; then uv sync --frozen --no-dev --package akp-worker; else uv sync --no-dev --package akp-worker; fi

FROM base AS runtime
RUN useradd --create-home --uid 10001 akp
WORKDIR /app
COPY --from=deps /app /app
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH="/app/apps/worker/src:/app/packages/akp-core/src:/app/packages/akp-config/src:/app/packages/akp-db/src:/app/packages/akp-observability/src"
USER akp
CMD ["akp-worker"]
